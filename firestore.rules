// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: works
// Fields:
//   - title: string (required)
//   - category: string (required)
//   - image: string (required, URL)
//   - createdAt: timestamp (required)
//
// Collection: testimonials
// Fields:
//   - name: string (required)
//   - quote: string (required)
//   - rating: number (required, 1-5)
//   - createdAt: timestamp (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "owoadeemmy@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidWork(data) {
      return hasRequiredFields(['title', 'category', 'image', 'createdAt']) &&
             hasOnlyAllowedFields(['title', 'category', 'image', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.category is string && data.category in ['Bespoke', 'Couture', 'Ready-to-Wear', 'Evening Wear', 'Tailored'] &&
             isValidUrl(data.image) &&
             data.createdAt is timestamp;
    }

    function isValidTestimonial(data) {
      return hasRequiredFields(['name', 'quote', 'rating', 'createdAt']) &&
             hasOnlyAllowedFields(['name', 'quote', 'rating', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 50 &&
             data.quote is string && data.quote.size() > 0 && data.quote.size() < 500 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /works/{workId} {
      allow read: if true;
      allow create: if isAdmin() && isValidWork(request.resource.data);
      allow update: if isAdmin() && isValidWork(request.resource.data);
      allow delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidTestimonial(request.resource.data);
      allow update: if isAdmin() && isValidTestimonial(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Only admin can create/update user roles
      allow write: if isAdmin();
    }
    
    match /test/connection {
      allow read: if true;
    }
  }
}
