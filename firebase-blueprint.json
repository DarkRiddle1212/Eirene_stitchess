{
  "entities": {
    "Work": {
      "title": "Work",
      "description": "A gallery item representing a tailored creation.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The title of the creation."
        },
        "category": {
          "type": "string",
          "description": "The category of the creation (e.g., Bespoke, Couture)."
        },
        "image": {
          "type": "string",
          "description": "The URL of the image."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the work was added."
        }
      },
      "required": ["title", "category", "image", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "A customer testimonial.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the customer."
        },
        "quote": {
          "type": "string",
          "description": "The testimonial quote."
        },
        "rating": {
          "type": "integer",
          "description": "The star rating (1-5)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The time the testimonial was added."
        }
      },
      "required": ["name", "quote", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/works": {
      "schema": "Work",
      "description": "Collection of gallery items."
    },
    "/testimonials": {
      "schema": "Testimonial",
      "description": "Collection of customer testimonials."
    }
  }
}
